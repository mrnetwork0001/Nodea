{
  "name": "nodea",
  "version": "1.0.0",
  "private": true,
  "description": "Autonomous Encrypted DeAI Compute & Private Agentic Infrastructure on COTI",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "compile": "TS_NODE_PROJECT=tsconfig.hardhat.json hardhat compile && npm run export-abi",
    "export-abi": "tsx scripts/export-abi.ts",
    "test": "TS_NODE_PROJECT=tsconfig.hardhat.json hardhat test",
    "test:live": "TS_NODE_PROJECT=tsconfig.hardhat.json hardhat test test/integration.test.ts",
    "test:live:testnet": "NODEA_NETWORK=cotiTestnet TS_NODE_PROJECT=tsconfig.hardhat.json hardhat test test/integration.test.ts",
    "keygen": "tsx scripts/keygen.ts",
    "deploy": "npm run deploy:mainnet",
    "deploy:mainnet": "NODEA_NETWORK=cotiMainnet TS_NODE_PROJECT=tsconfig.hardhat.json hardhat run scripts/deploy.ts --network cotiMainnet",
    "deploy:testnet": "NODEA_NETWORK=cotiTestnet TS_NODE_PROJECT=tsconfig.hardhat.json hardhat run scripts/deploy.ts --network cotiTestnet",
    "seed": "tsx scripts/seed.ts",
    "e2e": "tsx scripts/e2e.ts",
    "demo": "npm run seed && npm run e2e",
    "agent": "tsx agent/run.ts",
    "node-daemon": "tsx agent/node-daemon.ts"
  },
  "dependencies": {
    "@coti-io/coti-contracts": "^1.3.5",
    "@coti-io/coti-ethers": "^1.0.6",
    "@coti-io/coti-sdk-typescript": "^1.0.9",
    "@openzeppelin/contracts": "5.4.0",
    "ethers": "^6.13.1",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.474.0",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "chai": "^4.5.0",
    "dotenv": "^16.4.7",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "hardhat": "^2.29.1",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "keccak@3.0.4": true
  }
}
