# Nodea GPU node daemon.
#
#   sudo cp deploy/nodea-daemon.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now nodea-daemon
#
# Written to be a guest on a shared machine. It has no ports, no privileges it does not need, and
# hard ceilings on memory and CPU so it cannot starve whatever else is already running.

[Unit]
Description=Nodea GPU node daemon
Documentation=https://github.com/mrnetwork0001/Nodea
After=network-online.target
Wants=network-online.target

# Restart rate limiting lives in [Unit], not [Service] - systemd 230+ ignores it there with only a
# log line to say so. Without these a permanently broken build becomes an unbounded restart storm
# on a machine that is hosting other people's work.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=nodea
Group=nodea
WorkingDirectory=/opt/nodea

# Keys live outside the checkout, owned by nodea, mode 600. A `git pull` can never touch them and
# they are not in any build context.
EnvironmentFile=/etc/nodea/nodea.env

# Absolute path: a service unit has no shell profile, so nvm's node is invisible here.
ExecStart=/usr/bin/node /opt/nodea/node_modules/.bin/tsx /opt/nodea/agent/node-daemon.ts

# A node that stops answering while still advertising `active` accrues breaches, and each one is
# permanent in a public record. So: always restart. StartLimit prevents a genuinely broken build
# from becoming a restart storm that costs the whole machine.
Restart=always
RestartSec=10

# Long enough for a settlement in flight to land. The daemon stops accepting new jobs the moment
# SIGTERM arrives and finishes the one it is on; killing it in between would strand the escrow and
# cost that node a permanent SLA breach. Inference alone can take two minutes.
TimeoutStopSec=180
# node exits 143 on SIGTERM, which is a clean stop, not a failure. Without this every restart is
# logged as `Failed with result 'exit-code'` and counts against the start limit.
SuccessExitStatus=143 SIGTERM

# --- ceilings, so a leak here cannot take the neighbours down -----------------
MemoryMax=512M
MemoryHigh=384M
CPUQuota=50%
# 128, not 64: the TypeScript loader keeps an esbuild service alongside the daemon and the pair
# sits around 31 threads at idle. 64 left almost no headroom for a spike, and hitting TasksMax
# does not throttle - it fails the fork.
TasksMax=128

# --- confinement --------------------------------------------------------------
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
# ProtectSystem=strict makes the whole filesystem read-only. The daemon itself writes nothing but
# logs, and PrivateTmp gives it a private /tmp for anything transient. The one exception is the
# transpiler's cache: the leading `-` means "allow if it exists, do not refuse to start if it does
# not", so a cache write can never turn into a boot loop on a machine hosting other services.
ReadWritePaths=-/opt/nodea/node_modules/.cache

StandardOutput=journal
StandardError=journal
SyslogIdentifier=nodea-daemon

[Install]
WantedBy=multi-user.target
