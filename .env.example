# ---------------------------------------------------------------------------
# Nodea - environment template
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Target chain. Defaults to cotiMainnet; set cotiTestnet to work for free.
NODEA_NETWORK=cotiMainnet

# COTI RPC endpoints (defaults shown; override only for a private node)
COTI_MAINNET_RPC_URL=https://mainnet.coti.io/rpc
COTI_RPC_URL=https://testnet.coti.io/rpc

# ---------------------------------------------------------------------------
# Identities. Generate with `npm run keygen`.
#
# On mainnet these hold real COTI. There is no faucet - fund them yourself.
# Deploying all four contracts costs roughly 0.02 COTI at 2 gwei; 0.5 COTI
# across the three accounts covers deployment, onboarding and a seeded demo
# with room to spare.
# ---------------------------------------------------------------------------

# Deployer - owns NodeaCredits/NodeaSLA admin roles. Needs the most gas.
# NODEA_DEPLOYER_KEY=

# GPU node operator - registers nodes and submits proofs of execution.
# NODEA_NODE_OPERATOR_KEY=

# AI agent - hires compute, sends encrypted prompts, pays in encrypted NDC.
# NODEA_AGENT_KEY=

#   npm run compile && npm run deploy:mainnet && npm run seed && npm run e2e

# ---------------------------------------------------------------------------
# Node daemon - where a GPU operator's inference actually runs.
#
# Three backends, in priority order:
#   1. 0G Router       ZEROG_ROUTER_KEY set - one balance, no ledger minimum
#   2. 0G broker       ZEROG_PRIVATE_KEY set - per-provider ledger, 3 0G to open one
#   3. HTTP endpoint   NODEA_INFERENCE_URL set - any OpenAI-compatible URL
#   4. local stand-in  none of the above - deterministic, offline, no keys
#
# The 0G account belongs to the NODE OPERATOR, not the agent. The agent pays the
# node in encrypted NDC on COTI and never learns what the node spent on GPU, so
# the operator's margin stays as confidential as the prompt did.
#
#   npm run zerog:status     ledger balance, providers, cost per job
#   npm run zerog -- fund 0.1   deposit 0.1 0G
#   npm run zerog:test       one real inference, end to end
# ---------------------------------------------------------------------------
# --- Easiest: the 0G Compute Router --------------------------------------
# Deposit 0G and create an API key at https://pc.0g.ai, then paste it here.
# One unified balance, 31 models, no ledger and no minimum.
# ZEROG_ROUTER_KEY=

# --- Advanced: the on-chain broker ---------------------------------------
# Per-provider sub-accounts funded through a ledger. Needs at least 3 0G to
# open one, and a wallet holding native 0G on chain 16661.
#
# NOTE: these are SEPARATE balances. Depositing on pc.0g.ai funds the Router,
# not the ledger - a node can hold thousands of 0G and still fail addLedger.
# ZEROG_PRIVATE_KEY=

# ZEROG_NETWORK=mainnet          # or: testnet
# ZEROG_MODEL=                   # override the model a node resolves to
# ZEROG_PROVIDER=                # broker only: pin one provider address

# Fallback: any OpenAI-compatible endpoint.
# NODEA_INFERENCE_URL=https://your-endpoint/v1/chat/completions
# NODEA_INFERENCE_KEY=

# ---------------------------------------------------------------------------
# Dashboard overrides - only needed to point the UI at a deployment other than
# the one recorded in deployments/<network>.json
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_NODEA_NETWORK=cotiMainnet
# NEXT_PUBLIC_NODEA_CREDITS=
# NEXT_PUBLIC_NODEA_SLA=
# NEXT_PUBLIC_NODEA_PROMPT_CHANNEL=
# NEXT_PUBLIC_NODEA_COMPUTE=

# ---------------------------------------------------------------------------
# The live integration suite registers nodes and settles jobs, so on mainnet it
# spends real COTI. Opt in deliberately, or point it at testnet.
# ---------------------------------------------------------------------------
# NODEA_ALLOW_MAINNET_TESTS=1
