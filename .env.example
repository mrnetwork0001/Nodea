# ---------------------------------------------------------------------------
# Nodea — COTI Web4 Vibe Code Challenge
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# COTI RPC endpoints (defaults shown; override only for a private node)
COTI_RPC_URL=https://testnet.coti.io/rpc
COTI_MAINNET_RPC_URL=https://mainnet.coti.io/rpc

# Deployer — owns NodeaCredits/NodeaSLA admin roles. Needs COTI gas.
NODEA_DEPLOYER_KEY=

# Demo GPU node operator — registers a node and submits proofs of execution.
NODEA_NODE_OPERATOR_KEY=

# Demo AI agent — hires compute, sends encrypted prompts, pays in encrypted NDC.
NODEA_AGENT_KEY=

# Fund all three at https://faucet.coti.io (COTI testnet), then:
#   npm run compile && npm run deploy:testnet && npm run seed && npm run e2e

# ---------------------------------------------------------------------------
# Dashboard overrides — only needed to point the UI at a deployment other than
# the one recorded in deployments/cotiTestnet.json
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_NODEA_CREDITS=
# NEXT_PUBLIC_NODEA_SLA=
# NEXT_PUBLIC_NODEA_PROMPT_CHANNEL=
# NEXT_PUBLIC_NODEA_COMPUTE=
