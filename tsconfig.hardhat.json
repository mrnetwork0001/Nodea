{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": ".hardhat/tsc",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@nodea/*": [
        "./src/lib/nodea/*"
      ]
    }
  },
  "include": [
    "hardhat.config.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "agent/**/*.ts",
    "src/lib/nodea/**/*.ts"
  ]
}
